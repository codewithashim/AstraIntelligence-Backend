PORT=8000  # Port where the application runs
NODE_ENV=development  # Environment (development, production, staging)

#############################################
#              DATABASE CONFIG             #
#############################################
MONGO_URI=mongodb://localhost:27017

#############################################
#               DOMAIN CONFIG              #
#############################################
DOMAIN=http://localhost:8000  # Base domain for the application

#############################################
#               AUTH CONFIG                #
#############################################
JWT_SECRET=vVrl4lf9rg9YMEnddbzXPQXhjcTVo6x48RmEShWQdz8=  # Secret key for signing JWTs (keep it secure!)
JWT_REFRESH_SECRET=fdgsdffjioju54534543k5jjrffkewj8990yu= # Secret key for signing refresh JWTs (keep it secure!)
JWT_EXPIRE=7d  # JWT expiration time (e.g., 30d, 7d, 24h)
JWT_REFRESH_EXPIRE=7d  # JWT refresh expiration time (e.g., 30d, 7d, 24h)
BCRYPT_SALT_ROUND=10  # Bcrypt salt rounds


#############################################
#               EMAIL CONFIG                #
#############################################
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_FROM=noreply@yourapp.com

#############################################
#              AWS CONFIGURATION           #
#############################################
AWS_ACCESS_KEY_ID=your_aws_access_key  # AWS access key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key  # AWS secret key
AWS_REGION=ap-northeast-2  # AWS region
AWS_BUCKET_NAME=your_bucket_name  # AWS S3 bucket name

#############################################
#              CORS CONFIGURATION          #
#############################################
# Allowed domains for cross-origin requests (CORS)
ALLOW_DOMAINS=http://localhost:8000,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:5000